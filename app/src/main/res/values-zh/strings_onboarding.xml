    <!-- Page 2: Gallery & 10-bit HEIF Transcoding -->
    <string name="onboarding_page2_badge">高速浏览 · 无损软解</string>
    <string name="onboarding_page2_title">全屏相册与 10-bit HEIF 导出</string>
    <string name="onboarding_page2_desc">通过 PTP/IP 快速浏览机内存储，RAW + HIF 双格式智能合并为单张卡片。全屏高清暗色画廊支持双指平滑缩放与细节检焦，内置 libde265 多核软解，一键导出保留完整 EXIF 的高质量 JPEG。</string>
    <string name="onboarding_page2_feat1">RAW + JPG / HIF 智能归并卡片</string>
    <string name="onboarding_page2_feat2">全屏沉浸暗色画廊，双指放大检焦</string>
    <string name="onboarding_page2_feat3">10-bit 4:2:2 HEIF 一键无损转码</string>
    <string name="onboarding_anim_raw_badge">RAW + 10b HIF</string>
    <string name="onboarding_anim_heif_to_jpeg">10-bit HEIF → JPEG (95%)</string>

    <!-- Page 3: Wireless Shutter & Advanced Modes -->
    <string name="onboarding_page3_badge">BLE 低功耗 · 专业遥控</string>
    <string name="onboarding_page3_title">无线蓝牙快门与进阶拍摄</string>
    <string name="onboarding_page3_desc">严格还原物理两段式按压时序：半按锁定对焦、按住连拍松手即停。深度适配索尼蓝牙协议，支持长按与定时两种 B 门长曝光，以及手机端前台间隔拍摄与独立录像开关。</string>
    <string name="onboarding_page3_feat1">两段式半按对焦锁定与按住连拍</string>
    <string name="onboarding_page3_feat2">索尼蓝牙 B 门长曝光（长按／定时）</string>
    <string name="onboarding_page3_feat3">参数滑动条微调与独立录像开关</string>
    <string name="onboarding_anim_af_lock">合焦锁定</string>
    <string name="onboarding_anim_burst_mode">高速连拍</string>
    <string name="onboarding_anim_bulb_timer">B 门曝光</string>

