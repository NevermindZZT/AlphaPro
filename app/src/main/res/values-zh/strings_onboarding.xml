    <!-- Page 1: GPS Heartbeat & Time Sync -->
    <string name="onboarding_page1_badge">后台守护 · 永不断连</string>
    <string name="onboarding_page1_title">后台 GPS 守护与微秒对时</string>
    <string name="onboarding_page1_desc">独创 5 秒心跳保活守护，彻底解决官方 App 定位频繁断连与红标问题。系统级感知相机开机并自动重连，为每张照片精准注入地理位置与毫秒对齐的拍摄时间戳。</string>
    <string name="onboarding_page1_feat1">5 秒心跳保活，锁屏静止不掉线</string>
    <string name="onboarding_page1_feat2">微秒级 CC13 自动时钟校准</string>
